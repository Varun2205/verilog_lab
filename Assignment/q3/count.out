#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib64/ivl/system.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
S_0x555def6cb3d0 .scope module, "tb_decade_counter" "tb_decade_counter" 2 1;
 .timescale 0 0;
v0x555def6de4d0_0 .var "clk", 0 0;
v0x555def6de570_0 .net "count", 3 0, v0x555def6de2d0_0;  1 drivers
v0x555def6de640_0 .var "rst", 0 0;
S_0x555def6cb560 .scope module, "uut" "decade_counter" 2 5, 3 1 0, S_0x555def6cb3d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 4 "count";
v0x555def6b9d50_0 .net "clk", 0 0, v0x555def6de4d0_0;  1 drivers
v0x555def6de2d0_0 .var "count", 3 0;
v0x555def6de3b0_0 .net "rst", 0 0, v0x555def6de640_0;  1 drivers
E_0x555def6c9bd0 .event posedge, v0x555def6b9d50_0;
    .scope S_0x555def6cb560;
T_0 ;
    %wait E_0x555def6c9bd0;
    %load/vec4 v0x555def6de3b0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x555def6de2d0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x555def6de2d0_0;
    %cmpi/u 9, 0, 4;
    %flag_inv 5; GE is !LT
    %jmp/0xz  T_0.2, 5;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x555def6de2d0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x555def6de2d0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x555def6de2d0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x555def6cb3d0;
T_1 ;
    %vpi_call 2 8 "$dumpfile", "counter.vcd" {0 0 0};
    %vpi_call 2 9 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x555def6cb3d0 {0 0 0};
    %vpi_call 2 10 "$monitor", "Time = %0t | Reset = %b | Counter = %d", $time, v0x555def6de640_0, v0x555def6de570_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555def6de4d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555def6de640_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555def6de640_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555def6de4d0_0, 0, 1;
    %delay 200, 0;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x555def6de640_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x555def6de640_0, 0, 1;
    %delay 200, 0;
    %vpi_call 2 19 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x555def6cb3d0;
T_2 ;
    %delay 10, 0;
    %load/vec4 v0x555def6de4d0_0;
    %inv;
    %store/vec4 v0x555def6de4d0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_decade_counter.v";
    "decade_counter.v";
